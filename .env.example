# Local Docker Compose configuration. Generate long random values locally.
# No broker credentials or live-trading configuration are used by ATLAS.
ATLAS_DB_PASSWORD=replace-with-a-long-random-alphanumeric-value
ATLAS_BOOTSTRAP_TOKEN=replace-with-a-different-random-value-at-least-32-characters
# Optional local non-Docker database override; Compose uses its Postgres URL.
ATLAS_DATABASE_URL=sqlite:///./atlas.db
ATLAS_ENVIRONMENT=development
ATLAS_COOKIE_SECURE=false
ATLAS_SESSION_TTL_HOURS=12
ATLAS_LOGIN_MAX_FAILURES=5
ATLAS_LOGIN_WINDOW_SECONDS=900
ATLAS_ALLOWED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
# Optional authorized local history. Every symbol is loaded from SYMBOL.csv.
ATLAS_MARKET_DATA_DIR=
ATLAS_MARKET_DATA_SOURCE=
# Set true for synthetic history or false only for authorized real history.
ATLAS_MARKET_DATA_IS_SYNTHETIC=
